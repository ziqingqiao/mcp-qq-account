# ---------------------------------------------------------------------------
# MCP QQ Account - example configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Transport -------------------------------------------------------------
# stdio : launched by Claude Desktop / Cursor / WorkBuddy as a child process
# http  : long-running Streamable HTTP server (remote / multi-client)
MCP_TRANSPORT=stdio

# --- OneBot upstream -------------------------------------------------------
# The OneBot-compatible implementation that holds the QQ login session
# (NapCat, Lagrange, ...). This server never sees the QQ password: it talks to
# the account only through this HTTP API.
ONEBOT_BASE_URL=http://127.0.0.1:3000
# Sent as `Authorization: Bearer <value>` when set. Leave empty if your
# implementation has no token configured. Server-side only - the model never
# sees this and there is no tool parameter that accepts it.
ONEBOT_ACCESS_TOKEN=

# --- Upstream HTTP policy --------------------------------------------------
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_RETRIES=1

# --- Inbound event receiver ------------------------------------------------
# OneBot pushes events here (HTTP POST). This is how incoming messages reach
# the agent, because MCP itself is request/response and cannot be pushed to.
# Point your OneBot implementation's "HTTP report" at:
#   http://<QQ_EVENT_HOST>:<QQ_EVENT_PORT><QQ_EVENT_PATH>
QQ_EVENT_ENABLED=true
QQ_EVENT_HOST=127.0.0.1
QQ_EVENT_PORT=8790
QQ_EVENT_PATH=/onebot/events
# When set, reports must carry `Authorization: Bearer <value>` or a matching
# `?access_token=`. Recommended even on loopback: anything that can reach the
# port can otherwise inject messages into the agent's context.
QQ_EVENT_TOKEN=

# --- Inbox -----------------------------------------------------------------
# Where received messages are queued for the agent to read.
# Defaults to ./inbox-data next to this file.
QQ_INBOX_DIR=
# Upper bound on how many queued messages one qq_read_messages call returns.
QQ_INBOX_MAX_BATCH=50

# --- Safety switches -------------------------------------------------------
# Set to false to disable sending entirely while still allowing reads. Useful
# while you are watching what the account receives before letting a model
# speak as it.
QQ_SEND_ENABLED=true

# --- HTTP transport settings (ignored when MCP_TRANSPORT=stdio) ------------
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
HTTP_PATH=/mcp
# Comma-separated bearer keys the MCP client must present.
# Leave EMPTY for local development only - the server then logs a loud warning.
MCP_API_KEYS=
# Required when HTTP_HOST=0.0.0.0. Comma-separated hostnames (port-agnostic).
HTTP_ALLOWED_HOSTS=

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
